<Window x:Class="WinKitty.UI.ControlPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKitty - Panneau de contrôle"
        Width="300"
        Height="425">
        <StackPanel Margin="10">
                <TextBox x:Name="CatNameBox"
                         Text="Nom du chat"
                         Margin="0,0,0,10"/>
                <!-- stats -->
                <TextBlock Text="Faim"
                           Margin="0,0,0,2"/>
                <ProgressBar x:Name="HungerBar"
                             Minimum="0"
                             Maximum="100"
                             Height="16"
                             Margin="0,0,0,8"/>

                <TextBlock Text="Énergie"
                           Margin="0,0,0,2"/>
                <ProgressBar x:Name="EnergyBar"
                             Minimum="0"
                             Maximum="100"
                             Height="16"
                             Margin="0,0,0,8"/>

                <TextBlock Text="Propreté"
                           Margin="0,0,0,2"/>
                <ProgressBar x:Name="CleanlinessBar"
                             Minimum="0"
                             Maximum="100"
                             Height="16"
                             Margin="0,0,0,8"/>

                <TextBlock Text="Bonheur"
                           Margin="0,0,0,2"/>
                <ProgressBar x:Name="HappinessBar"
                             Minimum="0"
                             Maximum="100"
                             Height="16"
                             Margin="0,0,0,10"/>
                <Button Content="Basculer bureau uniquement"
                        Click="OnToggleDesktop"
                        Margin="0,0,0,5"/>
                <!-- actions -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,5">
                        <Button x:Name="SleepButton"
                                Content="Dormir"
                                Click="OnSleep"
                                Width="100"/>
                        <TextBox x:Name="SleepMinutesBox"
                                 Text="1"
                                 Width="40"
                                 Margin="5,0,0,0"/>
                        <TextBlock Text="min"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="SleepTimerText"
                           Text="00:00 / 00:00"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5">

                        <Button x:Name="PauseSleepButton"
                                Content="Pause"
                                Click="OnPauseSleep"
                                Width="100"
                                IsEnabled="False"/>

                        <Button x:Name="CancelSleepButton"
                                Content="Annuler"
                                Click="OnCancelSleep"
                                Width="100"
                                Margin="5,0,0,0"
                                IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="FeedButton"
                        Content="Nourrir"
                        Click="OnFeed"
                        Margin="0,0,0,5"/>
                <Button x:Name="PlayButton"
                        Content="Jouer"
                        Click="OnPlay"
                        Margin="0,0,0,5"/>
                <Button x:Name="CleanButton"
                        Content="Toilettes"
                        Click="OnClean"
                        Margin="0,0,0,5"/>
        </StackPanel>
</Window>
